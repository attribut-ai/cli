      "if": { "properties": { "tool": { "const": "claude_code" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/claudeCodePayload" } } }
    },
    {
      "if": { "properties": { "tool": { "const": "antigravity" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/antigravityPayload" } } }
