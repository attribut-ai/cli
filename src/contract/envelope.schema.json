{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attribut.ai/contracts/envelope.v1.json",
  "title": "ATTRIBUT ingest envelope v1",
  "type": "object",
  "required": ["provider", "tool", "schema_version", "payload"],
  "additionalProperties": false,
